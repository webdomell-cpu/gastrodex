rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Public read for catalog json and images; write restricted to authenticated admin
    match /catalog/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
