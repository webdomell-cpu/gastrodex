rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Curated encyclopedia database collections: publicly readable by Web, PWA, and Android app
    match /items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /categories/{catId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /quiz_questions/{questionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /catalog/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Authenticated user private storage (favorites, notes, inventory overrides)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
