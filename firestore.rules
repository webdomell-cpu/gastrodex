rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Curated encyclopedia database collections: readable and writable by Web Admin CMS, PWA, and Android app
    match /items/{itemId} {
      allow read, write: if true;
    }
    match /categories/{catId} {
      allow read, write: if true;
    }
    match /quiz_questions/{questionId} {
      allow read, write: if true;
    }
    match /catalog/{document=**} {
      allow read, write: if true;
    }

    // Authenticated user private storage (favorites, notes, inventory overrides)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
